# Port pelayan
PORT=3000
# URL awam gateway (digunakan dalam snippet, checkout_url, pautan bayaran).
# Pilihan di Render/Railway — dikesan automatik jika dibiarkan kosong.
BASE_URL=https://pay.domain-anda.com
# Lokasi fail pangkalan data SQLite
DB_PATH=data/bayarterus.db
# Tetapkan 1 jika berada di belakang reverse proxy (nginx, Cloudflare)
TRUST_PROXY=1
# Hari sebelum dana live boleh dikeluarkan (T+N)
LIVE_SETTLEMENT_DAYS=2
# Nama adapter pemproses live (lihat src/lib/processor.js). Kosong = live dimatikan.
LIVE_PROCESSOR=
